{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "nextjs", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-danger": "error",
    "jsx-a11y/no-autofocus": "error",
    "import/no-cycle": "error",
    "no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "**/*.scss", "server-only", "@/components/system/styles"]
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@scnx/**"],
            "message": "Use the design system through @/components/system: it is wrapped once, there, and nowhere else (TDD docs-site D17)."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["node_modules", ".next", "src/generated", "next-env.d.ts"],
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/components/system/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "A component depends only on components and shared libraries, never on a feature or a route (TDD docs-site D17)."
              }
            ]
          }
        ]
      }
    }
  ]
}
